/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3767-0000-common.h>

#define CAM0_SYNC	TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_SYNC	TEGRA234_MAIN_GPIO(AC, 0)
#define CAM_I2C_MUX 	TEGRA234_AON_GPIO(CC, 3)

/ {
	overlay-name = "Camera FG-4CH-4Lanes-YUV";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi  {
				num-channels = <8>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					vi_port0: port@0 {
						reg = <0>;
						fzcam_vi_in0: endpoint {
							vc-id = <0>;
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out0>;
						};
					};
					vi_port1: port@1 {
						reg = <1>;
						fzcam_vi_in1: endpoint {
							vc-id = <1>;
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out1>;
						};
					};
					vi_port2: port@2 {
						reg = <2>;
						fzcam_vi_in2: endpoint {
							vc-id = <2>;
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out2>;
						};
					};
					vi_port3: port@3 {
						reg = <3>;
						fzcam_vi_in3: endpoint {
							vc-id = <3>;
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out3>;
						};
					};
					vi_port4: port@4 {
						reg = <4>;
						fzcam_vi_in4: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out4>;
						};
					};
					vi_port5: port@5 {
						reg = <5>;
						fzcam_vi_in5: endpoint {
							vc-id = <1>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out5>;
						};
					};
					vi_port6: port@6 {
						reg = <6>;
						fzcam_vi_in6: endpoint {
							vc-id = <2>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out6>;
						};
					};
					vi_port7: port@7 {
						reg = <7>;
						fzcam_vi_in7: endpoint {
							vc-id = <3>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&fzcam_csi_out7>;
						};
					};
				};
			};

			tegra-camera-platform {
				status = "okay";
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <8>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <10>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <7500000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;

				modules {
					cam_module0: module0 {
						badge = "fz_bottomleft";
						position = "bottomleft";
						orientation = "1";
						cam_module0_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/fzcam_3a@3a";
						};
					};
					cam_module1: module1 {
						badge = "fz_centerleft";
						position = "centerleft";
						orientation = "1";
						cam_module1_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/fzcam_3b@3b";
						};
					};
					cam_module2: module2 {
						badge = "fz_topleft";
						position = "topleft";
						orientation = "1";
						cam_module2_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/fzcam_3c@3c";
						};
					};
					cam_module3: module3 {
						badge = "fz_frontcenter";
						position = "frontcenter";
						orientation = "1";
						cam_module3_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/fzcam_3d@3d";
						};
					};
					cam_module4: module4 {
						badge = "fz_bottomright";
						position = "bottomright";
						orientation = "1";
						cam_module4_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/fzcam_3a@3a";
						};
					};
					cam_module5: module5 {
						badge = "fz_centerright";
						position = "centerright";
						orientation = "1";
						cam_module5_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/fzcam_3b@3b";
						};
					};
					cam_module6: module6 {
						badge = "fz_topright";
						position = "topright";
						orientation = "1";
						cam_module6_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/fzcam_3c@3c";
						};
					};
					cam_module7: module7 {
						badge = "fz_rearcenter";
						position = "rearcenter";
						orientation = "1";
						cam_module7_drivernode0: drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/fzcam_3d@3d";
						};
					};
				};
			};
			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						num-channels = <8>;
						#address-cells = <1>;
						#size-cells = <0>;
						csi_chan0: channel@0 {
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan0_port0: port@0 {
									reg = <0>;
									fzcam_csi_in0: endpoint@0 {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out0>;
									};
								};
								csi_chan0_port1: port@1 {
									reg = <1>;
									fzcam_csi_out0: endpoint@1 {
										remote-endpoint = <&fzcam_vi_in0>;
									};
								};
							};
						};
						csi_chan1: channel@1 {
							reg = <1>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan1_port0: port@0 {
									reg = <0>;
									fzcam_csi_in1: endpoint@2 {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out1>;
									};
								};
								csi_chan1_port1: port@1 {
									reg = <1>;
									fzcam_csi_out1: endpoint@3 {
										remote-endpoint = <&fzcam_vi_in1>;
									};
								};
							};
						};
						csi_chan2: channel@2 {
							reg = <2>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan2_port0: port@0 {
									reg = <0>;
									fzcam_csi_in2: endpoint@4 {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out2>;
									};
								};
								csi_chan2_port1: port@1 {
									reg = <1>;
									fzcam_csi_out2: endpoint@5 {
										remote-endpoint = <&fzcam_vi_in2>;
									};
								};
							};
						};
						csi_chan3: channel@3 {
							reg = <3>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan3_port0: port@0 {
									reg = <0>;
									fzcam_csi_in3: endpoint@6 {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out3>;
									};
								};
								csi_chan3_port1: port@1 {
									reg = <1>;
									fzcam_csi_out3: endpoint@7 {
										remote-endpoint = <&fzcam_vi_in3>;
									};
								};
							};
						};						
						csi_chan4: channel@4 {
							reg = <4>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan4_port0: port@0 {
									reg = <0>;
									fzcam_csi_in4: endpoint@8 {
										port-index = <0>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out4>;
									};
								};
								csi_chan4_port1: port@1 {
									reg = <1>;
									fzcam_csi_out4: endpoint@9 {
										remote-endpoint = <&fzcam_vi_in4>;
									};
								};
							};
						};
						csi_chan5: channel@5 {
							reg = <5>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan5_port0: port@0 {
									reg = <0>;
									fzcam_csi_in5: endpoint@10 {
										port-index = <0>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out5>;
									};
								};
								csi_chan5_port1: port@1 {
									reg = <1>;
									fzcam_csi_out5: endpoint@11 {
										remote-endpoint = <&fzcam_vi_in5>;
									};
								};
							};
						};
						csi_chan6: channel@6 {
							reg = <6>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan6_port0: port@0 {
									reg = <0>;
									fzcam_csi_in6: endpoint@10 {
										port-index = <0>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out6>;
									};
								};
								csi_chan6_port1: port@1 {
									reg = <1>;
									fzcam_csi_out6: endpoint@11 {
										remote-endpoint = <&fzcam_vi_in6>;
									};
								};
							};
						};
						csi_chan7: channel@7 {
							reg = <7>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								csi_chan7_port0: port@0 {
									reg = <0>;
									fzcam_csi_in7: endpoint@10 {
										port-index = <0>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_out7>;
									};
								};
								csi_chan7_port1: port@1 {
									reg = <1>;
									fzcam_csi_out7: endpoint@11 {
										remote-endpoint = <&fzcam_vi_in7>;
									};
								};
							};
						};
					};
				};

				cam_i2cmux {
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					i2c-parent = <&cam_i2c>;
					mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;

					i2c_1:i2c@1 {
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;

						fzcam_3d@3d {
							compatible = "nvidia,fzcam";
							sensor_model ="fzcam";
							reg = <0x3d>;

							/* Physical dimensions of sensor */
							physical_w = "15.0";
							physical_h = "12.5";

							mode0 {
								mclk_khz = "37125";
								num_lanes = "4";
								tegra_sinterface = "serial_c";
								vc_id  = "3";
								
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								csi_pixel_bit_depth = "16";
								mode_type = "yuv";
								pixel_phase = "uyvy";

								active_w = "1920";
								active_h = "1080";
								readout_orientation = "0";
								line_length = "2200";
								inherent_gain = "1";
								
								pix_clk_hz = "74250000";
								serdes_pix_clk_hz = "375000000";
								
								gain_factor = "10";
								min_gain_val = "0"; /* 0dB */
								max_gain_val = "480"; /* 48dB */
								step_gain_val = "3"; /* 0.3 */
								default_gain = "0";

								min_hdr_ratio = "1";
								max_hdr_ratio = "1";

								framerate_factor = "1000000";
								min_framerate = "30000000"; /* 1.5 */
								max_framerate = "30000000"; /* 30 */
								step_framerate = "1";
								default_framerate= "30000000";

								exposure_factor = "1000000";
								min_exp_time = "30"; /* us */
								max_exp_time = "660000"; /* us */
								step_exp_time = "1";
								default_exp_time = "33334";/* us */
								embedded_metadata_height = "0";
							};
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									fzcam_out3: endpoint {
										vc-id = <3>;
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_csi_in3>;
									};
								};
							};
						};
						fzcam_3c@3c {
							compatible = "nvidia,fzcam";
							sensor_model ="fzcam";
							reg = <0x3c>;

							/* Physical dimensions of sensor */
							physical_w = "15.0";
							physical_h = "12.5";

							mode0 {
								mclk_khz = "37125";
								num_lanes = "4";
								tegra_sinterface = "serial_c";
								vc_id  = "2";
								
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								csi_pixel_bit_depth = "16";
								mode_type = "yuv";
								pixel_phase = "uyvy";

								active_w = "1920";
								active_h = "1080";
								readout_orientation = "0";
								line_length = "2200";
								inherent_gain = "1";
								
								pix_clk_hz = "74250000";
								serdes_pix_clk_hz = "375000000";
								
								gain_factor = "10";
								min_gain_val = "0"; /* 0dB */
								max_gain_val = "480"; /* 48dB */
								step_gain_val = "3"; /* 0.3 */
								default_gain = "0";

								min_hdr_ratio = "1";
								max_hdr_ratio = "1";

								framerate_factor = "1000000";
								min_framerate = "30000000"; /* 1.5 */
								max_framerate = "30000000"; /* 30 */
								step_framerate = "1";
								default_framerate= "30000000";

								exposure_factor = "1000000";
								min_exp_time = "30"; /* us */
								max_exp_time = "660000"; /* us */
								step_exp_time = "1";
								default_exp_time = "33334";/* us */
								embedded_metadata_height = "0";
							};
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									fzcam_out2: endpoint {
										vc-id = <2>;
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_csi_in2>;
									};
								};
							};
						};
						fzcam_3b@3b {
							compatible = "nvidia,fzcam";
							sensor_model ="fzcam";
							reg = <0x3b>;

							/* Physical dimensions of sensor */
							physical_w = "15.0";
							physical_h = "12.5";

							mode0 {
								mclk_khz = "37125";
								num_lanes = "4";
								tegra_sinterface = "serial_c";
								vc_id  = "1";
								
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								csi_pixel_bit_depth = "16";
								mode_type = "yuv";
								pixel_phase = "uyvy";

								active_w = "1920";
								active_h = "1080";
								readout_orientation = "0";
								line_length = "2200";
								inherent_gain = "1";
								
								pix_clk_hz = "74250000";
								serdes_pix_clk_hz = "375000000";
								
								gain_factor = "10";
								min_gain_val = "0"; /* 0dB */
								max_gain_val = "480"; /* 48dB */
								step_gain_val = "3"; /* 0.3 */
								default_gain = "0";

								min_hdr_ratio = "1";
								max_hdr_ratio = "1";

								framerate_factor = "1000000";
								min_framerate = "30000000"; /* 1.5 */
								max_framerate = "30000000"; /* 30 */
								step_framerate = "1";
								default_framerate= "30000000";

								exposure_factor = "1000000";
								min_exp_time = "30"; /* us */
								max_exp_time = "660000"; /* us */
								step_exp_time = "1";
								default_exp_time = "33334";/* us */
								embedded_metadata_height = "0";
							};
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									fzcam_out1: endpoint {
										vc-id = <1>;
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_csi_in1>;
									};
								};
							};
						};
						fzcam_3a@3a {
							compatible = "nvidia,fzcam";
							sensor_model ="fzcam";
							reg = <0x3a>;

							/* Physical dimensions of sensor */
							physical_w = "15.0";
							physical_h = "12.5";
							
							mode0 {
								mclk_khz = "37125";
								num_lanes = "4";
								tegra_sinterface = "serial_c";
								vc_id  = "0";
								
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								csi_pixel_bit_depth = "16";
								mode_type = "yuv";
								pixel_phase = "uyvy";

								active_w = "1920";
								active_h = "1080";
								readout_orientation = "0";
								line_length = "2200";
								inherent_gain = "1";
								
								pix_clk_hz = "74250000";
								serdes_pix_clk_hz = "375000000";
								
								gain_factor = "10";
								min_gain_val = "0"; /* 0dB */
								max_gain_val = "480"; /* 48dB */
								step_gain_val = "3"; /* 0.3 */
								default_gain = "0";

								min_hdr_ratio = "1";
								max_hdr_ratio = "1";

								framerate_factor = "1000000";
								min_framerate = "30000000"; /* 1.5 */
								max_framerate = "30000000"; /* 30 */
								step_framerate = "1";
								default_framerate= "30000000";

								exposure_factor = "1000000";
								min_exp_time = "30"; /* us */
								max_exp_time = "660000"; /* us */
								step_exp_time = "1";
								default_exp_time = "33334";/* us */
								embedded_metadata_height = "0";
							};
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									fzcam_out0: endpoint {
										vc-id = <0>;
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&fzcam_csi_in0>;
									};
								};
							};
						};
					};
					
					i2c_0:i2c@0 {
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						
						fzcam_3d@3d {
							compatible = "nvidia,fzcam";
							sensor_model ="fzcam";
							reg = <0x3d>;

							/* Physical dimensions of sensor */
							physical_w = "15.0";
							physical_h = "12.5";

							mode0 {
								mclk_khz = "37125";
								num_lanes = "4";
								tegra_sinterface = "serial_a";
								lane_polarity = "6";
								vc_id = "3";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								csi_pixel_bit_depth = "16";
								mode_type = "yuv";
								pixel_phase = "uyvy";

								active_w = "1920";
								active_h = "1080";
								readout_orientation = "0";
								line_length = "2200";
								inherent_gain = "1";
								pix_clk_hz = "74250000";
								serdes_pix_clk_hz = "375000000";

								gain_factor = "10";
								min_gain_val = "0"; /* 0dB */
								max_gain_val = "480"; /* 48dB */
								step_gain_val = "3"; /* 0.3 */
								default_gain = "0";

								min_hdr_ratio = "1";
